{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**", "scripts/**", "tests/**", "target-app/src/**", "*.ts"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["scripts/**", "tests/**"],
      "linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
    },
    {
      "includes": ["target-app/**"],
      "linter": { "rules": { "complexity": { "useOptionalChain": "off" } } }
    }
  ]
}
